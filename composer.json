{
    "name": "logipro/smsclient-sender-php",
    "type": "app",
    "description": "start a new PHP project with a simple base structure",
    "keywords": ["php", "DDT"],
    "homepage": "https://github.com/frederic100/SMS",
    "license": "Copyrighted",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "symfony/http-client": "^7.2"
        
    },
    "require-dev": {
        "infection/extension-installer": "0.1.2",
        "infection/infection": "^0.29",
        "phpstan/phpdoc-parser": "2.*",
        "phpstan/phpstan": "2.*",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "3.*",
        "behat/behat": "^3.14"
    },
    "autoload": {
        "psr-4" : {
            "SmsClientPhp\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4" : {
            "Tests\\Unit\\SmsClientPhp\\" : "tests/unit",
            "Tests\\Features\\SmsClientPhp\\": "tests/acceptation/Features",
            "Tests\\Integration\\SmsClientPhp\\": "tests/integration"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
